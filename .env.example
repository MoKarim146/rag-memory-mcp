# Safe local defaults. Copy to .env for local development; never commit .env.

PORT=8787
HOST=127.0.0.1
AI_MEMORY_DIR=./examples/sample-vault
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed to call the server. Leave empty: MCP clients such as Claude Code send no Origin header.
ALLOWED_ORIGINS=

# Writes. false = read-only: the four write tools are not offered and every write is refused.
AI_MEMORY_WRITE_ENABLED=true
# Which writes wait for you in "AI Review/pending.md" instead of being saved:
# suspicious (default: text that looks like instructions to an AI), all (every write), off (none).
AI_MEMORY_WRITE_REVIEW=suspicious
# Offer only these tools (comma separated). Empty = all of them.
# Example, search only: AI_MEMORY_TOOLS=search_memory,read_note
AI_MEMORY_TOOLS=
# Record every write (time, tool, file, outcome, size and hash, never the text) in .history/audit.jsonl.
AI_MEMORY_AUDIT_LOG=true

# Per-session limits.
MCP_MAX_CALLS_PER_MINUTE=120
MCP_MAX_WRITES_PER_10_MIN=20

# Token login. Off by default for local use. Turn it on before exposing the server beyond this computer.
# With MCP_WRITE_TOKEN a client can use every tool; with MCP_READ_TOKEN only the read tools.
# Tokens must be at least 32 characters. Make one with: openssl rand -hex 32
# Clients send it as the HTTP header: Authorization: Bearer <token>
MCP_AUTH_REQUIRED=false
MCP_READ_TOKEN=replace-with-long-random-read-token
MCP_WRITE_TOKEN=replace-with-long-random-write-token

# Search. Keyword search (SQLite FTS5) is always on and fully local.
# Optional vectors on top: none (default), ngram (built in, no download, helps with typos, not synonyms)
# or ollama (a real embedding model running in Ollama on this computer; only loopback URLs are accepted).
RAG_EMBEDDINGS=none
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_OLLAMA_MODEL=nomic-embed-text
# Vector hits below this cosine similarity are ignored (default 0.35 for ngram, 0.45 for ollama).
# RAG_MIN_SIMILARITY=0.45
# Show each undated note's last-change date in search results (helps prefer newer notes; about 8% more tokens).
RAG_SHOW_DATES=false
# Most notes the search index takes in.
RAG_MAX_NOTES=20000

# Masking of personal data in everything the AI reads (secret-looking strings are always masked).
MASK_EMAILS=true
MASK_PHONE_NUMBERS=true

# Notes you never want an AI to see: put "ai_private: true" in the note's front matter, or the tag #ai-private.
