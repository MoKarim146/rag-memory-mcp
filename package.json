{
  "name": "rag-memory-mcp",
  "version": "0.2.0",
  "description": "Token-saving, security-hardened MCP memory server: one shared markdown memory for several AI assistants, with local RAG search.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:local": "./scripts/start.sh",
    "test": "./scripts/test.sh",
    "test:unit": "vitest run",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "hono": "^4.13.16",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.6"
  }
}
